{
  "name": "sydney-miniature",
  "private": true,
  "homepage": "https://somphol.github.io/sydney-miniature/",
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.4" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/notices.mjs dist/THIRD_PARTY_NOTICES.txt && node scripts/inline-build.mjs dist dist-single/index.html",
    "test": "node tests/run.mjs",
    "verify": "node scripts/verify.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright-core": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
